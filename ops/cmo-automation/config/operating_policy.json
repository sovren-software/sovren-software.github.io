{
  "transition": {
    "fiverr_overlap_hours": 48,
    "objective": "replace outsourced engagement with in-house automation without activity pause"
  },
  "success_targets_30d": {
    "qualified_follower_growth_pct": 8,
    "median_engagement_per_post_lift_pct": 25,
    "short_generic_reply_share_max_pct": 30
  },
  "automation": {
    "mode": "hybrid-manual-review",
    "execution_model": "roots_auto_replies_manual",
    "root_posts": "auto_scheduled",
    "reply_candidates": "generated_for_manual_review",
    "quote_candidates": "generated_for_manual_review",
    "live_execution": "never_automatic",
    "dry_run_default": true
  },
  "account_strategy": {
    "TheCesarCross": {
      "role": "founder",
      "mix_pct": {"root": 35, "reply": 50, "quote": 15},
      "daily_reply_cap": 8,
      "time_windows_est": ["09:00-11:00", "18:00-20:00"]
    },
    "sovren_software": {
      "role": "brand",
      "mix_pct": {"root": 45, "reply": 40, "quote": 15},
      "daily_reply_cap": 10,
      "time_windows_est": ["10:00-11:00", "14:00-15:00", "19:00-20:00"]
    }
  },
  "targeting": {
    "strategy": "core-whitelist-plus-discovery",
    "exploration_budget_pct": 20,
    "core_whitelist_pct": 80,
    "minimum_relevance_score": 0.7,
    "founder_scope": "whitelist_plus_approved_discovery"
  },
  "founder_denylist": {
    "preset": "strict",
    "categories": [
      "mainstream_consumer_brands",
      "meme_bait",
      "partisan_politics",
      "token_price_speculation",
      "celebrity_gossip",
      "giveaway_airdrop_threads"
    ],
    "keywords": [
      "skittles",
      "giveaway",
      "airdrop",
      "win free",
      "retweet to win",
      "$btc to",
      "$eth to",
      "meme coin",
      "pump",
      "moon",
      "vote red",
      "vote blue"
    ]
  },
  "copy_style": {
    "for_all_accounts": {
      "no_exclamation_marks": true,
      "no_emojis": true,
      "no_em_dash_or_en_dash": true,
      "no_hashtags": true,
      "no_links_in_replies": true,
      "unique_contextual_replies": true,
      "tone": "relevant_and_interesting"
    }
  },
  "cmo_alignment": {
    "category": "structural_trust_infrastructure",
    "ecosystem_scope": [
      "Sovren Software",
      "Esver OS",
      "Mr Haven",
      "Engram",
      "Dendrite"
    ],
    "message_relevance_gate": {
      "must_map_to_at_least_one": [
        "mission",
        "product_capability",
        "roadmap_milestone",
        "verification_proof"
      ],
      "disallow_generic_hot_takes": true,
      "disallow_unanchored_trend_chasing": true
    }
  },
  "risk_controls": {
    "max_replies_per_hour_per_account": 8,
    "max_replies_to_same_user_per_24h": 1,
    "avoid_repeated_same_user_within_hours": 24,
    "random_delay_seconds_min": 45,
    "random_delay_seconds_max": 180
  }
