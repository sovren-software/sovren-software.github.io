{
  "name": "sovren-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sovren Software marketing site — sovren.software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovren-software/sovren-software.github.io.git"
  },
  "homepage": "https://sovren.software",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write src",
    "generate-og": "node scripts/generate-og.js",
    "post": "node scripts/daily-post.js",
    "post:dry": "node scripts/daily-post.js --dry-run",
    "post:list": "node scripts/daily-post.js --list"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.68.0",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.0.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^3.5.2",
    "satori": "^0.26.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "twitter-api-v2": "^1.29.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "geist": "^1.7.0"
  },
  "overrides": {
